# .htaccess прода russia-flights.ru (~/russia-flights/public_html/).
# В репозитории — как источник истины; на прод попадает только ручным
# scp по отдельному подтверждению, cron его не трогает.

# ── Редиректы ─────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Блокировка .git (была до аудита — не удалять)
    RewriteRule ^\.git(/.*)?$ - [F,L]

    # HTTP -> HTTPS. Прод за nginx-прокси Timeweb: TLS терминируется
    # на nginx, Apache видит запрос как HTTP, поэтому признак схемы —
    # заголовок X-Forwarded-Proto. Проверка %{HTTPS} здесь дала бы
    # петлю редиректов.
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://russia-flights.ru%{REQUEST_URI} [R=301,L]

    # Фолбэк на случай, если прокси не передаёт X-Forwarded-Proto,
    # а Apache сам видит схему (иначе оба условия ложны и правило спит).
    RewriteCond %{HTTP:X-Forwarded-Proto} =""
    RewriteCond %{HTTPS} =off
    RewriteRule ^ https://russia-flights.ru%{REQUEST_URI} [R=301,L]

    # www -> apex (заодно закрывает SEO-дубль)
    RewriteCond %{HTTP_HOST} ^www\.russia-flights\.ru$ [NC]
    RewriteRule ^ https://russia-flights.ru%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Блокировка служебных файлов (было до аудита — не удалять) ──
<FilesMatch "^(ftp_test\.txt|README\.md|\.ftp-deploy-sync-state\.json|update_routes\.py|\.env)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# ── Security-заголовки ────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # HSTS. Включён 14.08.2026 после живой проверки редиректа
    # HTTP->HTTPS (301 в один прыжок, без петель). preload не подан —
    # это отдельное необратимое решение, принимать осознанно.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # CSP в режиме Report-Only: ничего не блокирует, нарушения видны
    # в консоли браузера (F12 -> Console). Погонять 1-2 недели на всех
    # слоях карты и с Вебвизором, добить недостающие источники, затем
    # переименовать в Content-Security-Policy.
    # Источники: jsdelivr (Leaflet, с SRI), mc.yandex.ru (Метрика) и тайлы.
    # С 15.08.2026 тайлы только легальные: официальный Tiles API Яндекса,
    # OpenStreetMap и OpenTopoMap (a/b/c — его субдомены). Хосты Google
    # (mt0-3) и неофициальный core-renderer-tiles.maps.yandex.net убраны
    # вместе со слоями. Шрифты self-host — font-src 'self'.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://mc.yandex.ru; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self'; img-src 'self' data: https://tiles.api-maps.yandex.ru https://tile.openstreetmap.org https://a.tile.opentopomap.org https://b.tile.opentopomap.org https://c.tile.opentopomap.org https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru wss://mc.yandex.ru; frame-src https://mc.yandex.ru; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"

    # HTML и routes.json: кэшировать можно, но перепроверять по ETag —
    # свежесть после ежечасного cron-pull гарантирована, 304 дешёвые.
    # Статику (favicon и пр.) хостинг уже кэширует на год — не трогаем.
    <FilesMatch "\.(html|json)$">
        Header always set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
